# KeyShift Environment Variables
# Copy this file to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=generate-a-secure-random-key-here #this is necessary

# Optional: token required on first-run setup to create the admin user.
# If unset, a random one is generated and printed in the container logs.
SETUP_TOKEN=
FLASK_ENV=production
FLASK_DEBUG=false

# Database
DATABASE_URL=sqlite:///KeyShift.db


# Security
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Timezone
TZ=America/Chicago
