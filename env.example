# KeyShift Environment Variables
# Copy this file to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=generate-a-secure-random-key-here #this is necessary

# Optional: token required on first-run setup to create the admin user.
# If unset, a random one is generated and printed in the container logs.
SETUP_TOKEN=
FLASK_ENV=production
FLASK_DEBUG=false

# Database
DATABASE_URL=sqlite:///KeyShift.db


# Security
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Timezone
TZ=America/Chicago

# Number of reverse proxies in front of KeyShift (e.g. 1 for one ingress/nginx).
# Needed for per-client rate limiting; leave 0 if clients connect directly.
TRUSTED_PROXY_COUNT=0

# Rate-limit counters. The default in-memory store is only exact with one worker.
# Set to a shared store (e.g. redis://redis:6379, needs the "redis" package) before
# raising GUNICORN_WORKERS above 1.
#RATELIMIT_STORAGE_URI=memory://
#GUNICORN_WORKERS=1
#GUNICORN_THREADS=8

# Key used to encrypt Wi-Fi passwords in the database and controller credentials in
# config.json. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is generated once into data/db/encryption.key. BACK IT UP with the
# database: without the key the stored passwords cannot be read. To rotate, put the new
# key first and keep the old one after a comma: ENCRYPTION_KEY=new,old
ENCRYPTION_KEY=

# Optional: where to post a message when a scheduled password change fails
# (Slack/Discord-style incoming webhook). Failures are always logged and shown in the UI.
ALERT_WEBHOOK_URL=
